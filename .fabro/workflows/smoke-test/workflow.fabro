digraph SmokeTest {
    graph [goal="Confirm Fabro can inspect this repository"]
    rankdir=LR

    start [shape=Mdiamond, label="Start"]
    exit  [shape=Msquare, label="Exit"]

    inspect [
        label="Inspect Docs",
        reasoning_effort="low",
        prompt="Read docs/reference/fabro/llms.txt. Confirm that its first heading is '# Fabro', count the tutorial pages listed, and report both results. Do not modify files."
    ]

    start -> inspect -> exit
}
