#!/usr/bin/env bash
# Fabro development shortcuts.
#
#   bin/dev up     Start this project's local Dev Container.
#   bin/dev down   Stop this project's local Dev Container.
#   bin/dev setup  Connect Fabro to an LLM account (interactive device sign-in).
#   bin/dev run    List available workflows; use `bin/dev run <workflow>` to run one locally.
#   bin/dev ui     Print the Fabro web UI URL and development token.
#   bin/dev status Show Fabro's configured provider and server status.
#
# Works from either side of the container boundary: from the host it drives the
# Dev Container with `docker exec`, and inside the Dev Container or a GitHub
# Codespace it runs the commands directly.

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workspace_dir="/workspaces/$(basename "${project_root}")"
fabro_port=32276

# Three separate questions, deliberately kept apart.
#
# `inside_container` decides how to run a command: the Fabro CLI on PATH means
# we are already in the container, where there is no Docker socket to reach it
# through. It is true in a Codespace and in a local Dev Container alike.
#
# `is_codespaces` decides how the port reaches a browser, and what we tell a
# human about the container's lifecycle, which GitHub owns rather than us.
if command -v fabro >/dev/null 2>&1; then
  inside_container=1
else
  inside_container=0
fi

is_codespaces() {
  [[ "${CODESPACES:-}" == "true" || -n "${CODESPACE_NAME:-}" ]]
}

# Which interface the server binds is a question about how the port is exposed,
# not about where this script happens to be running -- the two look alike from
# inside a container and are not the same.
#
# A Codespace forwards the port from inside the container, so loopback is both
# enough and the smaller exposure. A local Dev Container is reached through the
# `appPort` publish in devcontainer.json, and Docker forwards that to the
# container's eth0 address, never to its loopback -- so a loopback-only server
# leaves docker-proxy with nothing to connect to and the browser sees
# ERR_CONNECTION_RESET.
if is_codespaces; then
  bind_address="127.0.0.1:${fabro_port}"
else
  bind_address="0.0.0.0:${fabro_port}"
fi

container_id() {
  docker ps -q --filter "label=devcontainer.local_folder=${project_root}" | head -n 1
}

require_container() {
  local id
  id="$(container_id)"
  if [[ -z "${id}" ]]; then
    printf 'Dev Container is not running. Start it with:\n  bin/dev up\n' >&2
    exit 1
  fi
  printf '%s' "${id}"
}

# Interactive: keeps a TTY attached for device sign-in and workflow output.
run_in_container() {
  if (( inside_container )); then
    (cd "${project_root}" && "$@")
  else
    docker exec -u node -w "${workspace_dir}" -it "$(require_container)" "$@"
  fi
}

# Non-interactive: for commands whose output we capture or discard.
run_in_container_quiet() {
  if (( inside_container )); then
    (cd "${project_root}" && "$@")
  else
    docker exec -u node -w "${workspace_dir}" "$(require_container)" "$@"
  fi
}

dev_token_path() {
  if (( inside_container )); then
    printf '%s/.fabro/storage/server.dev-token' "${HOME}"
  else
    printf '/home/node/.fabro/storage/server.dev-token'
  fi
}

# The address to open in a browser. In a Codespace that is the forwarded-ports
# domain; on a host running a Dev Container it is the published port. This is
# not the origin the server advertises -- the fabro dev container feature owns
# that, and gets it right as of 1.2.1.
browse_url() {
  if is_codespaces && [[ -n "${CODESPACE_NAME:-}" && -n "${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN:-}" ]]; then
    printf 'https://%s-%s.%s' "${CODESPACE_NAME}" "${fabro_port}" "${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}"
  else
    printf 'http://localhost:%s' "${fabro_port}"
  fi
}

# Where the container already exists, say so rather than failing obscurely:
# neither `devcontainer up` nor `docker stop` can reach out from inside it.
explain_lifecycle_from_inside() {
  if is_codespaces; then
    printf 'This Codespace is managed by GitHub; use the Codespaces controls to stop or restart it.\n'
  else
    printf 'Already inside the Dev Container. Run `bin/dev %s` from the host instead.\n' "$1"
  fi
}

list_workflows() {
  local workflow_file
  for workflow_file in "${project_root}"/.fabro/workflows/*/workflow.toml; do
    [[ -f "${workflow_file}" ]] || continue
    printf '  %s\n' "$(basename "$(dirname "${workflow_file}")")"
  done | sort
}

command="${1:-help}"

case "${command}" in
  up)
    if (( inside_container )); then
      explain_lifecycle_from_inside up
    else
      devcontainer up --workspace-folder "${project_root}"
    fi
    ;;
  down)
    if (( inside_container )); then
      explain_lifecycle_from_inside down
    else
      id="$(container_id)"
      if [[ -z "${id}" ]]; then
        printf 'Dev Container is not running.\n'
      else
        docker stop "${id}"
      fi
    fi
    ;;
  setup)
    run_in_container fabro-setup "${@:2}"
    run_in_container_quiet fabro server restart --bind "${bind_address}"
    ;;
  run)
    workflow="${2:-}"
    if [[ -z "${workflow}" ]]; then
      printf 'Available workflows:\n'
      list_workflows
      printf '\nRun one with:\n  bin/dev run <workflow>\n'
      exit 0
    fi
    run_in_container fabro run "${workflow}" --environment local
    ;;
  ui)
    token_path="$(dev_token_path)"
    if ! run_in_container_quiet test -r "${token_path}"; then
      printf 'Fabro is not configured for the Dev Container user. Run:\n  bin/dev setup\n' >&2
      exit 1
    fi
    token="$(run_in_container_quiet cat "${token_path}")"
    printf 'Fabro web UI: %s\n' "$(browse_url)"
    printf 'Fabro development token: %s\n' "${token}"
    ;;
  status)
    run_in_container fabro-status
    run_in_container fabro server status
    ;;
  help|-h|--help)
    sed -n '2,9p' "${BASH_SOURCE[0]}"
    ;;
  *)
    printf 'Unknown command: %s\n\n' "${command}" >&2
    sed -n '2,9p' "${BASH_SOURCE[0]}" >&2
    exit 2
    ;;
esac
