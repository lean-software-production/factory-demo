#!/usr/bin/env bash
# Fabro development shortcuts.
#
#   bin/dev up     Start this project's local Dev Container.
#   bin/dev down   Stop this project's local Dev Container.
#   bin/dev setup  Connect Fabro to an LLM account (interactive device sign-in).
#   bin/dev run    List available workflows; use `bin/dev run <workflow>` to run one locally.
#   bin/dev ui     Print the Fabro web UI URL and development token.
#   bin/dev status Show Fabro's configured provider and server status.

set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
workspace_dir="/workspaces/$(basename "${project_root}")"

is_codespaces() {
  [[ "${CODESPACES:-}" == "true" || -n "${CODESPACE_NAME:-}" ]]
}

container_id() {
  docker ps -q --filter "label=devcontainer.local_folder=${project_root}" | head -n 1
}

require_container() {
  local id
  id="$(container_id)"
  if [[ -z "${id}" ]]; then
    printf 'Dev Container is not running. Start it with:\n  devcontainer up --workspace-folder %q\n' "${project_root}" >&2
    exit 1
  fi
  printf '%s' "${id}"
}

run_in_container() {
  if is_codespaces; then
    "$@"
    return
  fi

  local id
  id="$(require_container)"
  docker exec -u node -w "${workspace_dir}" -it "${id}" "$@"
}

list_workflows() {
  local workflow_file
  for workflow_file in "${project_root}"/.fabro/workflows/*/workflow.toml; do
    [[ -f "${workflow_file}" ]] || continue
    printf '  %s\n' "$(basename "$(dirname "${workflow_file}")")"
  done | sort
}

fabro_ui_url() {
  if is_codespaces && [[ -n "${CODESPACE_NAME:-}" && -n "${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN:-}" ]]; then
    printf 'https://%s-32276.%s\n' "${CODESPACE_NAME}" "${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN}"
  else
    printf 'http://localhost:32276\n'
  fi
}

command="${1:-help}"

case "${command}" in
  up)
    if is_codespaces; then
      printf 'This Codespace is already managed by GitHub; use the Codespaces controls to stop or restart it.\n'
    else
      devcontainer up --workspace-folder "${project_root}"
    fi
    ;;
  down)
    if is_codespaces; then
      printf 'This Codespace is managed by GitHub; use the Codespaces controls to stop or restart it.\n'
    else
      id="$(container_id)"
      if [[ -z "${id}" ]]; then
        printf 'Dev Container is not running.\n'
      else
        docker stop "${id}"
      fi
    fi
    ;;
  setup)
    if is_codespaces; then
      fabro-setup "${@:2}"
      fabro server restart --bind 0.0.0.0:32276
    else
      id="$(require_container)"
      run_in_container fabro-setup "${@:2}"
      docker exec -u node "${id}" fabro server restart --bind 0.0.0.0:32276
    fi
    ;;
  run)
    workflow="${2:-}"
    if [[ -z "${workflow}" ]]; then
      printf 'Available workflows:\n'
      list_workflows
      printf '\nRun one with:\n  bin/dev run <workflow>\n'
      exit 0
    fi
    run_in_container fabro run "${workflow}" --environment local
    ;;
  ui)
    if is_codespaces; then
      token_path="${HOME}/.fabro/storage/server.dev-token"
      if [[ ! -r "${token_path}" ]]; then
        printf 'Fabro is not configured for this Codespace user. Run:\n  bin/dev setup\n' >&2
        exit 1
      fi
      token="$(cat "${token_path}")"
    else
      id="$(require_container)"
      if ! docker exec -u node "${id}" test -r /home/node/.fabro/storage/server.dev-token; then
        printf 'Fabro is not configured for the Dev Container user. Run:\n  bin/dev setup\n' >&2
        exit 1
      fi
      token="$(docker exec -u node "${id}" cat /home/node/.fabro/storage/server.dev-token)"
    fi
    printf 'Fabro web UI: %s\n' "$(fabro_ui_url)"
    printf 'Fabro development token: %s\n' "${token}"
    ;;
  status)
    run_in_container fabro-status
    run_in_container fabro server status
    ;;
  help|-h|--help)
    sed -n '2,9p' "${BASH_SOURCE[0]}"
    ;;
  *)
    printf 'Unknown command: %s\n\n' "${command}" >&2
    sed -n '2,9p' "${BASH_SOURCE[0]}" >&2
    exit 2
    ;;
esac
